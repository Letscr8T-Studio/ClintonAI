# Copy this file to .env.local and fill in the values. Never commit real values.
# Full reference: docs/engineering/environment.md

# --- Public (safe in the browser) ---
# The live site address, used for canonical URLs, the sitemap and social previews
NEXT_PUBLIC_SITE_URL=https://tryclinton.com
# Tally: the form ID is the last part of the share link (tally.so/r/XXXXXX)
NEXT_PUBLIC_TALLY_FORM_ID=XXXXXX

# Supabase for user sign-in (publishable key; row-level security protects the data).
# Local: `npx supabase status` after `npm run db:start`. Hosted: Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54721
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Google sign-in credentials do NOT go here: put them in supabase/.env (local CLI) or the
# Supabase dashboard > Authentication > Providers > Google (hosted). See docs/engineering/environment.md.

# --- Server only (never prefix with NEXT_PUBLIC_) ---
# Google OAuth client for "Connect Gmail" (same client as sign-in). Google Cloud > Clinton AI > Clients
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# AI check (optional; without it Clinton runs the rules only). platform.openai.com > API keys
AI_PROVIDER=openai
OPENAI_API_KEY=sk-xxxxxxxx
OPENAI_MODEL=gpt-5.4-mini

# Base URL for links inside emails (Safe Send). Production: https://tryclinton.com
APP_URL=http://localhost:3000

# Smart Delay. Key: openssl rand -base64 32 (back it up). Secret: 32+ random chars.
EMAIL_ENCRYPTION_KEY=base64-32-bytes
CRON_SECRET=a-long-random-secret-used-by-pg_cron

# Supabase: Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Founders console (/owner/login)
# Comma-separated founder emails allowed to sign in
ADMIN_EMAILS=you@example.com,cofounder@example.com
# The shared console password. Use a long, unique one.
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Signs the login cookie. 32+ random characters: openssl rand -base64 32
ADMIN_SESSION_SECRET=paste-the-output-of-openssl-rand-base64-32
